<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="LLD - Ingestion Pipeline" id="fa-ing-lld">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Ingestion Pipeline — LLD (fetch -> store [truth] -> enqueue -> async index)" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="30" as="geometry" /></mxCell>

        <!-- Column headers (actors) -->
        <mxCell id="h_cli" value="CLI / API" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="h_ing" value="IngestionService" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_sec" value="SecEdgarClient" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_pg" value="Postgres (repo)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_sqs" value="SQS (+DLQ)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="h_wk" value="Worker (Lambda)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="h_bed" value="Bedrock Titan" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="h_os" value="OpenSearch" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="60" width="120" height="40" as="geometry" /></mxCell>

        <!-- Steps (numbered rows) -->
        <mxCell id="s1" value="1. ingest(tenant, ticker, form, limit)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="520" height="40" as="geometry" /></mxCell>
        <mxCell id="s2" value="2. fetch_filings() — live EDGAR; offline sample fallback if no network" style="rounded=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="185" width="540" height="40" as="geometry" /></mxCell>
        <mxCell id="s3" value="3. compute SHA-256 checksum (per-tenant idempotency key)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="240" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="4. upsert_filing() — INSERT ... ON CONFLICT (tenant_id, sha256) DO NOTHING; status=PENDING; RLS set" style="rounded=1;whiteSpace=wrap;fillColor=#fde7e9;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="s5" value="5. if new -> enqueue IngestJob(tenant_id, filing_id)" style="rounded=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="295" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="s6" value="6. SQS triggers Worker (batch of 10, ReportBatchItemFailures)" style="rounded=1;whiteSpace=wrap;fillColor=#eaf5ea;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="350" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="s7" value="7. load raw_text (tenant-scoped) ; status=INDEXING ; ensure per-tenant index" style="rounded=1;whiteSpace=wrap;fillColor=#eaf5ea;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="620" y="405" width="620" height="40" as="geometry" /></mxCell>
        <mxCell id="s8" value="8. chunk_text (~800 tok, 120 overlap) + section detect (Item 1A ...)" style="rounded=1;whiteSpace=wrap;fillColor=#eaf5ea;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="460" width="500" height="40" as="geometry" /></mxCell>
        <mxCell id="s9" value="9. embed chunks (Titan V2, 1024-dim, normalized)" style="rounded=1;whiteSpace=wrap;fillColor=#efe3f3;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="515" width="500" height="40" as="geometry" /></mxCell>
        <mxCell id="s10" value="10. bulk index chunks (tenant_id guard) -> refresh" style="rounded=1;whiteSpace=wrap;fillColor=#e6eefb;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="500" height="40" as="geometry" /></mxCell>
        <mxCell id="s11" value="11. status=INDEXED (or FAILED -> retry; after maxReceiveCount=5 -> DLQ)" style="rounded=1;whiteSpace=wrap;fillColor=#fde7e9;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="620" y="625" width="620" height="40" as="geometry" /></mxCell>

        <mxCell id="note" value="Idempotency: same public filing can be ingested by different tenants (checksum unique per tenant).&#10;Decoupling: ingestion returns fast; slow embed/index runs async so the API path stays responsive.&#10;Resilience: SQS retries + DLQ quarantine a poison filing instead of blocking the pipeline." style="rounded=1;whiteSpace=wrap;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="900" height="90" as="geometry" /></mxCell>

        <!-- lifelines -->
        <mxCell id="ll1" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="100" as="sourcePoint" /><mxPoint x="100" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll2" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="100" as="sourcePoint" /><mxPoint x="290" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll3" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="100" as="sourcePoint" /><mxPoint x="490" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll4" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="100" as="sourcePoint" /><mxPoint x="690" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll5" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="100" as="sourcePoint" /><mxPoint x="880" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll6" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="100" as="sourcePoint" /><mxPoint x="1070" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll7" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="100" as="sourcePoint" /><mxPoint x="1260" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ll8" style="endArrow=none;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="100" as="sourcePoint" /><mxPoint x="1440" y="690" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
