<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="LLD - VPC Network and Infra" id="fa-vpc-lld">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="VPC / Network + Infra — LLD (Terraform modules)" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="800" height="30" as="geometry" /></mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC 10.20.0.0/16  (networking module)" style="swimlane;startSize=30;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1120" height="470" as="geometry" /></mxCell>

        <mxCell id="az_a" value="Private Subnet AZ-a (10.20.0.0/24)" style="swimlane;startSize=26;fillColor=#f0f7ff;strokeColor=#9cc3e6;fontSize=12;" vertex="1" parent="vpc"><mxGeometry x="30" y="50" width="520" height="380" as="geometry" /></mxCell>
        <mxCell id="rds" value="RDS Postgres (database module)&#10;db.t3.micro ; storage encrypted (KMS)&#10;Secrets Manager password ; SG:5432 from VPC" style="shape=mxgraph.aws4.rds;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="az_a"><mxGeometry x="30" y="45" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="os" value="OpenSearch domain (search module)&#10;t3.small.search ; node-to-node + at-rest enc&#10;SG:443 from VPC ; per-tenant indices" style="shape=mxgraph.aws4.opensearch_service;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="az_a"><mxGeometry x="30" y="155" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="lam" value="Worker Lambda (compute module)&#10;python3.12 ; in-VPC ; SG egress-all&#10;SQS event source mapping (batch 10)" style="shape=mxgraph.aws4.lambda;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="az_a"><mxGeometry x="30" y="265" width="440" height="90" as="geometry" /></mxCell>

        <mxCell id="az_b" value="Private Subnet AZ-b (10.20.1.0/24)" style="swimlane;startSize=26;fillColor=#f0f7ff;strokeColor=#9cc3e6;fontSize=12;" vertex="1" parent="vpc"><mxGeometry x="570" y="50" width="520" height="380" as="geometry" /></mxCell>
        <mxCell id="smep" value="SageMaker reranker endpoint (reranker module, OPT-IN)&#10;cross-encoder ; KMS ; invoked by worker/search&#10;shared across tenants (stateless, filtered shortlist)" style="shape=mxgraph.aws4.sagemaker;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="az_b"><mxGeometry x="30" y="45" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="haz" value="RDS Multi-AZ standby / OpenSearch replica&#10;(enable for prod HA; single-AZ for dev cost)" style="rounded=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#9cc3e6;fontSize=11;dashed=1;" vertex="1" parent="az_b"><mxGeometry x="30" y="160" width="440" height="80" as="geometry" /></mxCell>
        <mxCell id="ep" value="(prod) VPC endpoints for Bedrock/SQS/Secrets&#10;to keep traffic on the AWS backbone" style="rounded=1;whiteSpace=wrap;fillColor=#eef2f7;strokeColor=#9cc3e6;fontSize=11;dashed=1;" vertex="1" parent="az_b"><mxGeometry x="30" y="265" width="440" height="80" as="geometry" /></mxCell>

        <!-- Regional / managed services outside VPC -->
        <mxCell id="reg" value="Regional managed services (accessed via IAM, encrypted in transit)" style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1120" height="130" as="geometry" /></mxCell>
        <mxCell id="sqs" value="SQS ingest + DLQ&#10;(queue module, KMS)" style="shape=mxgraph.aws4.sqs;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="30" y="45" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="bed" value="Bedrock&#10;Titan V2 + Claude Sonnet" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="240" y="45" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="sm" value="Secrets Manager&#10;(DB credentials)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="470" y="45" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="mon" value="CloudWatch + AWS Budgets + SNS&#10;(monitoring module)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="670" y="45" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="secm" value="KMS + IAM least-privilege&#10;(security module)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="reg"><mxGeometry x="930" y="45" width="160" height="70" as="geometry" /></mxCell>

        <mxCell id="note" value="Dev cost posture: single-AZ, smallest instances, NO NAT Gateway. Prod: enable Multi-AZ, replicas, VPC endpoints. Reranker is opt-in (enable_reranker=true). Tear down with `make tf-destroy`." style="rounded=1;whiteSpace=wrap;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1120" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
