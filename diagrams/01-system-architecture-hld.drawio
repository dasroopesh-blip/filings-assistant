<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="HLD - System Architecture" id="fa-hld">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Filings Assistant — HLD System Architecture (Bedrock + OpenSearch + SageMaker)" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="30" as="geometry" /></mxCell>

        <!-- ============ INGESTION LANE (write path) ============ -->
        <mxCell id="lane_ing" value="INGESTION (write path) — async, decoupled" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="sec" value="SEC EDGAR&#10;(public 10-K/10-Q/8-K)" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="30" y="80" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="ingsvc" value="Ingestion Service&#10;fetch + checksum" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="210" y="80" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="pg" value="Aurora/RDS Postgres&#10;SOURCE OF TRUTH&#10;(tenant_id + RLS)" style="shape=cylinder3;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="400" y="75" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="sqs" value="SQS ingest queue&#10;(+ DLQ)" style="shape=mxgraph.aws4.sqs;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="610" y="80" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="worker" value="Worker (Lambda)&#10;chunk -> embed -> index" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="790" y="80" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="titan1" value="Bedrock — Titan V2&#10;embeddings" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="1000" y="40" width="150" height="55" as="geometry" /></mxCell>
        <mxCell id="os_idx" value="OpenSearch&#10;per-tenant index&#10;(kNN vector + BM25)" style="shape=mxgraph.aws4.opensearch_service;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_ing"><mxGeometry x="1210" y="75" width="150" height="90" as="geometry" /></mxCell>

        <mxCell id="e1" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="sec" target="ingsvc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="ingsvc" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="ingsvc" target="sqs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="sqs" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="worker" target="titan1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;rounded=1;" edge="1" parent="lane_ing" source="worker" target="os_idx"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ QUERY LANE (read path) ============ -->
        <mxCell id="lane_q" value="QUERY (read path) — Agentic RAG, tenant-scoped" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="1540" height="300" as="geometry" />
        </mxCell>
        <mxCell id="user" value="Analyst&#10;(authenticated)" style="shape=actor;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="30" y="110" width="90" height="80" as="geometry" /></mxCell>
        <mxCell id="auth" value="Auth (Cognito/JWT)&#10;-> tenant_id" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="160" y="115" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="agent" value="Agent (Bedrock Claude Sonnet)&#10;understand -> plan -> synthesize" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="340" y="60" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="mcp" value="MCP tools&#10;(tenant-bound)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="340" y="170" width="200" height="55" as="geometry" /></mxCell>
        <mxCell id="funnel" value="Ranking funnel&#10;1) Retrieve (BM25 + kNN)&#10;2) RRF fuse&#10;3) SageMaker rerank" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="lane_q"><mxGeometry x="600" y="90" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="os_q" value="OpenSearch&#10;per-tenant index" style="shape=mxgraph.aws4.opensearch_service;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="870" y="40" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="smr" value="SageMaker&#10;cross-encoder reranker" style="shape=mxgraph.aws4.sagemaker;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="870" y="150" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="titan2" value="Bedrock — Titan V2&#10;query embedding" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="1070" y="40" width="150" height="55" as="geometry" /></mxCell>
        <mxCell id="ans" value="Cited, grounded answer&#10;(no investment advice)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_q"><mxGeometry x="1070" y="150" width="180" height="70" as="geometry" /></mxCell>

        <mxCell id="q1" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="user" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="auth" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="agent" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="mcp" target="funnel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q5" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="funnel" target="os_q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q6" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="funnel" target="smr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q7" style="endArrow=block;rounded=1;dashed=1;" edge="1" parent="lane_q" source="funnel" target="titan2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q8" style="endArrow=block;rounded=1;" edge="1" parent="lane_q" source="agent" target="ans"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ CROSS-CUTTING ============ -->
        <mxCell id="lane_x" value="CROSS-CUTTING — security &amp; observability" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="650" width="1540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="kms" value="KMS (encryption at rest)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="lane_x"><mxGeometry x="40" y="45" width="200" height="45" as="geometry" /></mxCell>
        <mxCell id="iam" value="IAM least-privilege&#10;(Bedrock + SageMaker scoped)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="lane_x"><mxGeometry x="280" y="45" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="cw" value="CloudWatch — logs, latency, cost/query" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_x"><mxGeometry x="560" y="45" width="260" height="45" as="geometry" /></mxCell>
        <mxCell id="bud" value="AWS Budgets alarm (50% / 90%)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_x"><mxGeometry x="860" y="45" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="tf" value="Terraform IaC (all resources)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_x"><mxGeometry x="1140" y="45" width="220" height="45" as="geometry" /></mxCell>
