<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="LLD - Agent and MCP" id="fa-agent-lld">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Agentic AI + MCP — LLD (bounded tool-use reasoning loop)" style="text;fontSize=18;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="800" height="30" as="geometry" /></mxCell>

        <mxCell id="user" value="User prompt&#10;(tenant from auth)" style="shape=actor;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="110" height="80" as="geometry" /></mxCell>

        <mxCell id="qu" value="Query Understanding&#10;(Claude or heuristic)&#10;rewrite + extract filters&#10;(ticker/form/section)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="200" height="100" as="geometry" /></mxCell>

        <mxCell id="loop" value="FilingsAgent loop (bounded: max_steps=4)" style="swimlane;startSize=28;fillColor=#efe3f3;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="620" height="360" as="geometry" /></mxCell>
        <mxCell id="claude" value="Bedrock Claude Sonnet — converse()&#10;system prompt: ground + cite + no advice + tenant-only" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="loop"><mxGeometry x="30" y="45" width="440" height="70" as="geometry" /></mxCell>
        <mxCell id="dec" value="tool_use requested?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="loop"><mxGeometry x="150" y="140" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="exec" value="Execute tool via ToolRegistry&#10;(tenant injected server-side)" style="rounded=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="loop"><mxGeometry x="30" y="250" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="final" value="Final: cited, grounded answer&#10;+ citations + tool_calls + steps" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="loop"><mxGeometry x="330" y="250" width="250" height="70" as="geometry" /></mxCell>

        <mxCell id="lc1" style="endArrow=block;rounded=1;" edge="1" parent="loop" source="claude" target="dec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lc2" value="yes" style="endArrow=block;rounded=1;" edge="1" parent="loop" source="dec" target="exec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lc3" value="no" style="endArrow=block;rounded=1;" edge="1" parent="loop" source="dec" target="final"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lc4" value="tool result -> next turn" style="endArrow=block;rounded=1;dashed=1;" edge="1" parent="loop" source="exec" target="claude"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="130" as="targetPoint" /></mxGeometry></mxCell>

        <!-- MCP tools -->
        <mxCell id="mcpbox" value="MCP Server (stdio) + ToolRegistry — SAME handlers for agent &amp; external MCP clients" style="swimlane;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="620" height="230" as="geometry" /></mxCell>
        <mxCell id="t1" value="hybrid_search" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="30" y="45" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="t2" value="semantic_search" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="220" y="45" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="t3" value="keyword_search" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="410" y="45" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="t4" value="ingest_filing" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="30" y="100" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="t5" value="get_document" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="220" y="100" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="t6" value="list_filings" style="rounded=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="mcpbox"><mxGeometry x="410" y="100" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="tsec" value="SECURITY: tool schemas expose NO tenant_id — the LLM cannot specify a tenant. Tenant is injected from the bound TenantContext, so prompt-injection cannot cross tenants." style="rounded=1;whiteSpace=wrap;fillColor=#fde7e9;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="mcpbox"><mxGeometry x="30" y="155" width="550" height="55" as="geometry" /></mxCell>

        <mxCell id="ext" value="External MCP client&#10;(Claude Desktop, IDE, other agent)" style="shape=actor;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="120" height="90" as="geometry" /></mxCell>

        <mxCell id="a0" style="endArrow=block;rounded=1;" edge="1" parent="1" source="user" target="qu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a1" style="endArrow=block;rounded=1;" edge="1" parent="1" source="qu" target="loop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;rounded=1;" edge="1" parent="1" source="loop" target="mcpbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=block;rounded=1;dashed=1;" edge="1" parent="1" source="ext" target="mcpbox"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
